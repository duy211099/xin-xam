<main class="gate">
  <h1 class="sr-only">Chùa Máy</h1>
  <div class="stage">
    <.scene />
    <.vignette part="gate" />
    <.vignette part="court" />
    <ul class="machines">
      <li :for={m <- @machines}>
        <a
          class="machine"
          href={Machines.path(m)}
          style={"--x: #{elem(m.scene, 0)}%; --y: #{elem(m.scene, 1)}%; --accent: #{m.accent}"}
        >
          <img src={m.thumb} alt="" width={elem(m.thumb_size, 0)} height={elem(m.thumb_size, 1)} />
          <span class="machine-name">{m.name}</span>
          <span class="machine-tagline">{m.tagline}</span>
        </a>
      </li>
    </ul>
    <.vignette part="hall" />
  </div>
</main>
<script>
  (() => {
    const stage = document.querySelector(".stage");
    const still = () =>
      matchMedia("(prefers-reduced-motion: reduce)").matches || matchMedia("(max-width: 699px)").matches;

    stage.addEventListener("click", (e) => {
      const a = e.target.closest("a.machine");
      if (!a || e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || still()) return;
      e.preventDefault();
      const style = getComputedStyle(a);
      stage.style.transformOrigin = `${style.getPropertyValue("--x")} ${style.getPropertyValue("--y")}`;
      stage.classList.add("zooming");
      setTimeout(() => location.assign(a.href), 300);
    });

    addEventListener("pageshow", () => stage.classList.remove("zooming"));
  })();
</script>
