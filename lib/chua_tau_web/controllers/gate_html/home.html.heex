<main class="gate">
  <svg class="gate-art" viewBox="0 0 400 190" role="img" aria-label="Cổng chùa">
    <g
      fill="none"
      stroke="#2b1a10"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="5"
    >
      <path
        d="M12 52 Q60 58 110 40 L200 22 L290 40 Q340 58 388 52 Q372 70 346 72 L54 72 Q28 70 12 52 Z"
        fill="#b3261e"
      />
      <path d="M200 22 L200 10" />
      <path d="M62 72 L338 72" />
      <path d="M74 72 L74 184 M326 72 L326 184" stroke-width="9" />
      <path d="M62 184 L86 184 M314 184 L338 184" stroke-width="7" />
      <path d="M74 100 L326 100" stroke-width="7" />
      <path d="M150 100 L150 126 M250 100 L250 126" stroke-width="3" />
      <rect x="168" y="102" width="64" height="38" fill="#f3eee4" stroke-width="4" />
    </g>
    <path d="M182 118 h36 M200 108 v22" stroke="#b3261e" stroke-width="5" stroke-linecap="round" />
  </svg>
  <h1 class="gate-title">Cổng chùa</h1>
  <ul class="machines">
    <li :for={m <- @machines}>
      <a class="machine" href={Machines.path(m)} style={"--accent: #{m.accent}"}>
        <img src={m.thumb} alt="" width="300" height="400" />
        <span class="machine-name">{m.name}</span>
        <span class="machine-tagline">{m.tagline}</span>
      </a>
    </li>
  </ul>
</main>
