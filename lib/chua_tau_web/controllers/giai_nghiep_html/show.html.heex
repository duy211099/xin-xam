<main class="cert-wrap">
  <article class="cert">
    <p class="cert-machine">MÁY GIẢI NGHIỆP</p>
    <h1 class="cert-heading">GIẤY CHỨNG NHẬN ĐÃ GIẢI NGHIỆP</h1>
    <p class="cert-rule" aria-hidden="true"><span></span></p>
    <p class="cert-kind">Loại: {@label}</p>
    <p class="cert-valid">Hiệu lực: đến lần sau.</p>
    <div class="cert-seal" aria-hidden="true"><span>ĐÃ GIẢI</span></div>
  </article>
  <a class="cert-button" href="/giai-nghiep">Giải nghiệp</a>
  <a class="cert-back" href="/">← Cổng chùa</a>
</main>
